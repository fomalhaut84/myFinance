{
  "name": "myfinance",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && npm run build:mcp:staged && npm run build:mcp:activate && npm run build:bot",
    "build:mcp": "npm run build:mcp:staged && npm run build:mcp:activate",
    "build:mcp:staged": "esbuild src/mcp/server.ts --bundle --platform=node --target=node20 --outfile=dist/mcp/server.staged.cjs --alias:@=./src --external:@prisma/client --external:@modelcontextprotocol/sdk --external:dotenv --external:pino",
    "build:mcp:activate": "node -e \"const fs=require('fs'),p=require('path'); const src=p.join('dist','mcp','server.staged.cjs'); const dst=p.join('dist','mcp','server.cjs'); if(!fs.existsSync(src)){console.error('build:mcp:activate: staged 파일 없음'); process.exit(1);} fs.renameSync(src,dst); console.log('activated dist/mcp/server.cjs');\"",
    "build:bot": "esbuild src/bot/standalone.ts --bundle --platform=node --target=node20 --outfile=dist/bot/standalone.cjs --alias:@=./src --external:@prisma/client --external:grammy --external:node-cron --external:yahoo-finance2 --external:trading-signals --external:dotenv && npm run smoke:bot",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "smoke:bot": "node scripts/smoke-bot-bundle.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@prisma/client": "^6.19.2",
    "@react-pdf/renderer": "4.5.1",
    "dompurify": "^3.4.17",
    "dotenv": "^17.3.1",
    "grammy": "^1.41.1",
    "marked": "^17.0.4",
    "next": "^15.5.28",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "node-cron": "^4.2.1",
    "papaparse": "^5.5.3",
    "pino": "^10.3.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recharts": "^3.7.0",
    "trading-signals": "^7.4.3",
    "yahoo-finance2": "^3.15.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.12",
    "esbuild": "^0.28.1",
    "eslint": "^8",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.31",
    "prisma": "^6.19.2",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "js-yaml": "^4.3.2",
    "postcss": "^8.5.31",
    "next": {
      "postcss": "^8.5.31"
    },
    "postcss-selector-parser": "^7.1.6",
    "@react-pdf/font": "4.0.8",
    "@react-pdf/image": "3.1.0",
    "@react-pdf/layout": "4.6.1",
    "@react-pdf/primitives": "4.3.0",
    "@react-pdf/render": "4.5.1",
    "@react-pdf/stylesheet": "6.2.1",
    "@react-pdf/svg": "1.1.0",
    "@react-pdf/textkit": "6.3.0",
    "@react-pdf/types": "2.11.1",
    "deepmerge-ts": "^8.0.2"
  }
}
